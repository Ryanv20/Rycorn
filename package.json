{
  "name": "rycon-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Rycon — maritime network simulation engine",
  "scripts": {
    "test": "pnpm --filter @rycon/engine test",
    "test:server": "pnpm --filter @rycon/server test",
    "dev:server": "pnpm --filter @rycon/server dev",
    "dev:client": "pnpm --filter @rycon/client dev",
    "rycorn": "bash ./Rycorn",
    "test:ds": "pnpm --filter @rycon/ds-system test",
    "build:client": "pnpm --filter @rycon/client build",
    "demo": "pnpm tsx packages/engine/scripts/demo.ts"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "aws-cdk": "^2.1145.0",
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.8.1",
    "typescript": "^7.0.2",
    "tsx": "^4.23.12"
  }
}
