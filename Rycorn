#!/usr/bin/env bash
set -Eeuo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$repo_root"

if [[ ! -f package.json || ! -f pnpm-workspace.yaml ]]; then
  echo "Rycorn must be started from its repository root." >&2
  exit 1
fi

required_files=(
  "data/processed/canonical-ports.json"
  "data/raw/natural-earth/ne_10m_land.shp"
  "data/raw/natural-earth/ne_10m_land.shx"
  "data/raw/natural-earth/ne_10m_land.dbf"
)
for required_file in "${required_files[@]}"; do
  if [[ ! -s "$required_file" ]]; then
    echo "Required Rycorn data file is missing or empty: $required_file" >&2
    exit 1
  fi
done

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pnpm is required. Install pnpm, then run ./Rycorn again." >&2
  exit 1
fi

echo "Preparing workspace dependencies from the local pnpm cache (offline)..."
if ! pnpm install --offline --frozen-lockfile; then
  echo "Rycorn cannot start offline because a dependency is missing from the local pnpm cache." >&2
  echo "Reconnect once and run: pnpm install" >&2
  exit 1
fi

find_open_port() {
  local candidate="$1"
  while (( candidate < 65536 )); do
    if node -e 'const server = require("node:net").createServer(); server.once("error", () => process.exit(1)); server.listen(Number(process.argv[1]), "0.0.0.0", () => server.close(() => process.exit(0)));' "$candidate" >/dev/null 2>&1; then
      printf '%s' "$candidate"
      return 0
    fi
    ((candidate += 1))
  done
  echo "No open port found starting at $1." >&2
  return 1
}

api_port="$(find_open_port "${RYCORN_API_PORT:-3000}")"
client_port="$(find_open_port "${RYCORN_CLIENT_PORT:-5173}")"
port_console_port="$(find_open_port "${RYCORN_PORT_CONSOLE_PORT:-5176}")"
export RYCORN_API_PORT="$api_port"
export RYCORN_CLIENT_PORT="$client_port"
export RYCORN_PORT_CONSOLE_PORT="$port_console_port"
export VITE_RYCORN_API_PORT="$api_port"
export NEXT_PUBLIC_RYCORN_API_ORIGIN="http://localhost:${api_port}"

echo "Starting Rycorn API, WebSocket server, network client, and Los Angeles port console..."
echo "API: http://localhost:${api_port}"
echo "Network client: http://localhost:${client_port}"
echo "Los Angeles port console: http://localhost:${port_console_port}"
echo "Initialize and run the simulation from either console."
lan_addresses="$(hostname -I 2>/dev/null || true)"
if [[ -n "$lan_addresses" ]]; then
  for address in $lan_addresses; do
    echo "Phone on the same Wi-Fi (network client): http://${address}:${client_port}"
    echo "Phone on the same Wi-Fi (LA port console): http://${address}:${port_console_port}"
  done
else
  echo "Phone on the same Wi-Fi: open this computer's IP address at port ${client_port} or ${port_console_port}."
fi
exec pnpm -r --parallel --filter @rycon/server --filter @rycon/client --filter @rycorn/new-file dev
